# Application settings
ENVIRONMENT=development
PORT=8080
CORS_ORIGINS=http://localhost:5173

# Google Cloud & BigQuery settings (local dev uses cdr_tracking_dev; Cloud Run uses cdr_tracking_prod)
GCP_PROJECT_ID=gen-lang-client-0230474681
BQ_DATASET=cdr_tracking_dev
BQ_LOCATION=US
# Optional for local dev if not using `gcloud auth application-default login`:
GOOGLE_APPLICATION_CREDENTIALS=

# External API keys (fill in your values in .env)
MARKET_DATA_API_KEY=

